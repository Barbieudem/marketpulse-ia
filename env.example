# Copia este archivo como .env y llena tus valores. NUNCA subas .env a GitHub.

# Opción A: Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opción B: Vertex AI con créditos de Google Cloud for Education
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=tu-proyecto-id
# GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-3.5-flash

# YouTube Data API v3 (comentarios en tiempo real)
YOUTUBE_API_KEY=
